# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# App Check & AI Logic Configuration
VITE_FIREBASE_APPCHECK_KEY=your_recaptcha_site_key
# Cloud fallback model. gemini-2.0-flash was shut down on June 1, 2026.
# gemini-2.5-flash still answers on the Gemini Developer API today, but Firebase re-routes it to
# gemini-3.5-flash-lite from Dec 1, 2026 (inside the judging window). Check the Firebase AI Logic
# "supported models" page and test with Diagnostics > Only In Cloud before relying on any name.
VITE_FIREBASE_CLOUD_MODEL=gemini-3.5-flash-lite
